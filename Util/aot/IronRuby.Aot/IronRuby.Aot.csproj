<Project Sdk="Microsoft.NET.Sdk">
  <!-- Ahead-of-time compilation of Ruby to a saved .NET assembly (see ../README.md). It needs .NET 9+
       (PersistedAssemblyBuilder), so it targets net10.0. Its one use in the build is the startup library
       (IronRuby.Startup.dll, ../build-startup.sh), which the Linux Release build makes for the R2R host.

       It runs IronRuby's front end in-process, and what that produces is saved as IL that calls into the host's
       IronRuby and DLR: so it references the builds the host is made of - IronRubyAotHostTfm, net8.0 by
       default - not net10.0 builds of its own. A net10.0 process runs those as it would its own.
         dotnet build Util/aot/IronRuby.Aot -c Release -p:DlrSourceDir=... -p:IronRubyTargetFrameworks=net8.0 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IronRubyAotHostTfm Condition="'$(IronRubyAotHostTfm)' == ''">$([System.String]::Copy('$(IronRubyTargetFrameworks);').Split(';')[0])</IronRubyAotHostTfm>
    <IronRubyAotHostTfm Condition="'$(IronRubyAotHostTfm)' == ''">net8.0</IronRubyAotHostTfm>
    <OutputType>Exe</OutputType>
    <AssemblyName>IronRuby.Aot</AssemblyName>
    <RootNamespace>IronRuby.Aot</RootNamespace>
    <!-- a later runtime than 10 runs it too: it only needs PersistedAssemblyBuilder -->
    <RollForward>Major</RollForward>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CS0105;$(NoWarn);CS1591;CS0618;CS8632;CS0162;CS0168;CS0219;CS0028;CS0414;SYSLIB0050;SYSLIB0051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../Src/Ruby/Ruby.csproj" SetTargetFramework="TargetFramework=$(IronRubyAotHostTfm)" />
    <ProjectReference Include="../../../Src/Libraries/IronRuby.Libraries.csproj" SetTargetFramework="TargetFramework=$(IronRubyAotHostTfm)" />
    <ProjectReference Include="../../../Src/Prism/IronRuby.Prism.csproj" SetTargetFramework="TargetFramework=$(IronRubyAotHostTfm)" />
    <ProjectReference Include="$(DlrSourceDir)/Microsoft.Scripting/Microsoft.Scripting.csproj" SetTargetFramework="TargetFramework=$(IronRubyAotHostTfm)" />
    <ProjectReference Include="$(DlrSourceDir)/Microsoft.Dynamic/Microsoft.Dynamic.csproj" SetTargetFramework="TargetFramework=$(IronRubyAotHostTfm)" />
  </ItemGroup>
</Project>
