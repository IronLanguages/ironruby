@@ -0,0 +1,42 @@
+// Licensed to the .NET Foundation under one or more agreements.
+// The .NET Foundation licenses this file to you under the Apache 2.0 License.
+// See the LICENSE file in the project root for more information.
+
+using System;
+using System.Threading;
+
+namespace Microsoft.Scripting.Interpreter {
+    /// <summary>
+    /// Lets a host hold back the compilations the interpreter starts on another thread once an interpreted lambda
+    /// or rule has run often enough (LightLambda, CachedBindingInfo). While held back, a lambda or rule that reaches
+    /// its threshold is not compiled but given its threshold again: it keeps being interpreted and is compiled if it
+    /// stays hot after the hold ends. Meant for work a host knows to be one-off - a language loading its prelude: the
+    /// code that runs hot there is mostly not what the program runs hot, the compilations compete with the work for
+    /// the CPU, and a short program is over before they finish. Synchronous compilation (a threshold of 0 or 1) and
+    /// loop compilation are not affected.
+    /// </summary>
+    public static class BackgroundCompilation {
+        private static int _holdDepth;
+
+        /// <summary>
+        /// Holds back background compilations until the returned object is disposed. Holds nest and may be taken by
+        /// different threads; compilations resume when the last one is released.
+        /// </summary>
+        public static IDisposable HoldBack() {
+            Interlocked.Increment(ref _holdDepth);
+            return new Hold();
+        }
+
+        internal static bool IsHeldBack => Volatile.Read(ref _holdDepth) > 0;
+
+        private sealed class Hold : IDisposable {
+            private int _released;
+
+            public void Dispose() {
+                if (Interlocked.Exchange(ref _released, 1) == 0) {
+                    Interlocked.Decrement(ref _holdDepth);
+                }
+            }
+        }
+    }
+}
