     internal static class AssemblyTypeNames {
         public static IEnumerable<TypeName> GetTypeNames(Assembly assem, bool includePrivateTypes) {
+#if NET
+            // The names come from the assembly's metadata. GetExportedTypes/GetForwardedTypes answer the
+            // same names, but load every public type to do it - thousands for System.Private.CoreLib, ~20 ms
+            // of a process that only asks the namespace tree whether some name is a namespace.
+            if (!includePrivateTypes) {
+                var names = TryGetPublicTypeNamesFromMetadata(assem);
+                if (names is not null) {
+                    return names;
+                }
+            }
+#endif
             return from t in ReflectionUtils.GetAllTypesFromAssembly(assem, includePrivateTypes)
                    where !t.IsNested
                    select new TypeName(t);
         }
 
+#if NET
+        /// <summary>
+        /// The top-level public types the assembly defines and the top-level types it forwards, as
+        /// GetExportedTypes and GetForwardedTypes list them, read from the metadata tables without
+        /// loading any type. Null when the assembly has no raw metadata to read (a dynamic assembly).
+        /// </summary>
+        private static unsafe List<TypeName> TryGetPublicTypeNamesFromMetadata(Assembly assem) {
+            if (assem.IsDynamic) {
+                return null;
+            }
+
+            System.Reflection.Metadata.MetadataReader reader;
+            try {
+                if (!System.Reflection.Metadata.AssemblyExtensions.TryGetRawMetadata(assem, out byte* blob, out int length)) {
+                    return null;
+                }
+                reader = new System.Reflection.Metadata.MetadataReader(blob, length);
+            } catch (Exception) {
+                return null;
+            }
+
+            var result = new List<TypeName>();
+            foreach (var handle in reader.TypeDefinitions) {
+                var type = reader.GetTypeDefinition(handle);
+                // public and not nested (a nested type's visibility is one of the Nested* values)
+                if ((type.Attributes & TypeAttributes.VisibilityMask) == TypeAttributes.Public) {
+                    result.Add(new TypeName(NamespaceOrNull(reader.GetString(type.Namespace)), reader.GetString(type.Name)));
+                }
+            }
+
+            foreach (var handle in reader.ExportedTypes) {
+                var exported = reader.GetExportedType(handle);
+                // a nested forwarder's implementation is the forwarder of the type it is nested in
+                if (exported.IsForwarder && exported.Implementation.Kind == System.Reflection.Metadata.HandleKind.AssemblyReference) {
+                    result.Add(new TypeName(NamespaceOrNull(reader.GetString(exported.Namespace)), reader.GetString(exported.Name)));
+                }
+            }
+
+            return result;
+        }
+
+        // Type.Namespace is null for a type in the global namespace; the metadata has an empty string.
+        private static string NamespaceOrNull(string ns) => ns.Length == 0 ? null : ns;
+#endif
+
         private static IEnumerable<TypeName> GetTypeNames(string[] namespaces, string[][] types) {
