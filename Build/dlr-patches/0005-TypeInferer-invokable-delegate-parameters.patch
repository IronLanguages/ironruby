+                    }
+                }
+                return false;
+            }
+
+            private static bool Mentions(Type/*!*/ type, Type/*!*/ genericParameter) {
+                if (type == genericParameter) {
+                    return true;
+                }
+                if (type.HasElementType) {
+                    return Mentions(type.GetElementType(), genericParameter);
+                }
+                if (type.IsGenericType) {
+                    foreach (Type argument in type.GetGenericArguments()) {
+                        if (Mentions(argument, genericParameter)) {
+                            return true;
+                        }
+                    }
+                }
+                return false;
+            }
