+            private static bool DelegateParametersMention(Type/*!*/ parameterType, Type/*!*/ genericParameter) {
+                if (!parameterType.IsSubclassOf(typeof(Delegate))) {
+                    return false;
+                }
+
+                MethodInfo invoke = parameterType.GetMethod("Invoke");
+                if (invoke is null) {
+                    return false;
+                }
+
+                foreach (ParameterInfo parameter in invoke.GetParameters()) {
