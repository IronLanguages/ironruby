--- a/src/core/Microsoft.Dynamic/Interpreter/Instructions/CallInstruction.cs
+++ b/src/core/Microsoft.Dynamic/Interpreter/Instructions/CallInstruction.cs
@@ -25,6 +25,19 @@ namespace Microsoft.Scripting.Interpreter {
         
         private static readonly Dictionary<MethodInfo, CallInstruction> _cache = new();
 
+        /// <summary>
+        /// The instruction <see cref="Create(MethodInfo, ParameterInfo[])"/> made and cached for <paramref name="info"/>
+        /// before, if any. A method is cached only once it is known to need none of the special handling Create
+        /// checks for (array accessors, by-ref parameters, value-type instance methods, dynamic methods, too many
+        /// arguments), so a hit can skip GetParameters() - which copies the parameter array on every call - and
+        /// those checks altogether.
+        /// </summary>
+        internal static bool TryGetCached(MethodInfo info, out CallInstruction instruction) {
+            lock (_cache) {
+                return _cache.TryGetValue(info, out instruction);
+            }
+        }
+
         /// <exception cref="SecurityException">Instruction can't be created due to insufficient privileges.</exception>
         public static CallInstruction Create(MethodInfo info) {
             return Create(info, info.GetParameters());
