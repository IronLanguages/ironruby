+            /// <summary>
+            /// Divides <paramref name="value"/>, which is less than _powers[i]**2, by _powers[i].
+            /// </summary>
+            private BigInteger DivRem(BigInteger value, int i, out BigInteger remainder) {
+                BigInteger divisor = _powers[i];
+                int bits = _powerBits[i];
+                if (bits == 0) {
+                    _powerBits[i] = bits = BitLength(divisor);
+                }
+                // A short quotient (the top split of a number a little longer than a power) is cheap to divide out:
+                if (!s_useBarrett || bits < BarrettBits || BitLength(value) - bits < bits / 8) {
+                    return BigInteger.DivRem(value, divisor, out remainder);
+                }
+
+                BigInteger reciprocal = _reciprocals[i];
+                if (reciprocal.IsZero) {
+                    _reciprocals[i] = reciprocal = Reciprocal(divisor, bits);
+                }
