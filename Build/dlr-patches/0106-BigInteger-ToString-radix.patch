+
+            private readonly int _radix;
+            private readonly int _groupDigits;
+            private readonly BigInteger[] _powers;      // _powers[i] = radix ** (k * 2**i)
+            private readonly int[] _powerBits;          // their bit lengths, found when first needed
+            private readonly BigInteger[] _reciprocals; // floor(4 ** _powerBits[i] / _powers[i]), found when first needed
+
+            /// <summary>The level of the whole number: it has at most Digits(TopLevel) digits.</summary>
