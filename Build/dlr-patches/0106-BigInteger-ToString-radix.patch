+        /// radix ** (k * 2**(level + 1)), where radix**k is the largest power of the radix that fits in a uint, is split by
+        /// radix ** (k * 2**level) into a high and a low half of k * 2**level digits each, down to pieces of a few words.
+        /// </summary>
+        private sealed class RadixConverter {
+            // A piece of at most 2**LeafLevel digit groups (about as many 32-bit words) is converted by dividing its words
+            // in place by radix**k, which yields k digits per pass over the words.
+            private const int LeafLevel = 3;
+
+            // BigInteger.DivRem is quadratic before .NET 9 (which divides by Burnikel-Ziegler), while its multiplication
+            // is Karatsuba. There, a split by a power of the radix of at least BarrettBits bits uses Barrett reduction
+            // with a reciprocal found by Newton's method, which takes only multiplications: a million-bit number takes
+            // ~0.55 s instead of ~2.7 s on .NET 8. On .NET 9 and later BigInteger.DivRem is faster than that (~0.3 s).
+            // (.NET Framework multiplies in quadratic time too, so it gains nothing from it.)
+            private static readonly bool s_useBarrett = Environment.Version.Major >= 5 && Environment.Version.Major < 9;
+            private const int BarrettBits = 1 << 12;
+
+            // A reciprocal of at most this many bits is found with one BigInteger division.
