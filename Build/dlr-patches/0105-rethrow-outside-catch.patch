+                    // Rethrown once the catch is left, not from inside it: on CoreCLR a catch handler runs on
+                    // top of the frames the exception came out of, which are popped only when it completes, so
+                    // a `throw;' here kept them all - and every interpreted frame the exception passes catches
+                    // it (a finally to run is enough), so a deep recursion's stack-overflow error needed stack
+                    // in proportion to its depth to get out, and ended the process. Leaving the catch first
+                    // gives that stack back; the dispatch info keeps the exception's trace.
+                    rethrow = ExceptionDispatchInfo.Capture(exception);
                 }
+                rethrow.Throw();
