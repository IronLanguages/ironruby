# Output directories
obj/
bin/
/bin/
# ... except the standard library's own bin, which is source: the executables
# it ships (irb).  The directory has to be re-included before the files in it,
# since git does not look inside an excluded directory.
!/Src/StdLib/bin/
!/Src/StdLib/bin/*
# ... and the bin/ directories of the gems installed in the standard library's gem home
# (Util/install-bundled-gems.rb): minitest, racc and test-unit keep their executables there.
!/Src/StdLib/ruby/gems/*/gems/*/bin/
# ... and the templates `bundle gem` writes a new gem's bin/console and bin/setup from.
!/Src/StdLib/ruby/4.0/bundler/templates/newgem/bin/
# librbs, built by Util/build-librbs.sh
/Src/Libraries/Rbs/native/build/
# Util/package-release.sh output
/dist/

# Visual Studio state
.vs/
*.csproj.user

/NuGet.config
*.bak
# Anchored and without a trailing slash on purpose: a trailing slash matches
# only directories, so an agent worktree's `spec` -> ... symlink was NOT
# ignored, got committed, and a later merge replaced the real checkout with it.
/mspec
/spec
/rubyspec_temp/

# Where Util/rubybench/run.sh puts the gems a bundled benchmark needs.
/.gems

# Agent worktrees and local session state; the project's skills are shared
/.claude/*
!/.claude/skills/
!/.claude/hooks/
!/.claude/settings.json
# scratch copies of ir.sh pointing at an out-of-tree build
/ir[0-9].sh

# Util/build-markly.sh output: cmark-gfm built from the markly gem, per platform
/Src/Libraries/Markly/native/build/
