*_name_S*

# Output directories
obj/
bin/
/bin/
# ... except the standard library's own bin, which is source: the executables
# it ships (irb).  The directory has to be re-included before the files in it,
# since git does not look inside an excluded directory.
!/Src/StdLib/bin/
!/Src/StdLib/bin/*
# ... and the bin/ directories of the gems installed in the standard library's gem home
# (Util/install-bundled-gems.rb): minitest, racc and test-unit keep their executables there.
!/Src/StdLib/ruby/gems/*/gems/*/bin/
/Stage
/Package
# librbs, built by Util/build-librbs.sh
/Src/Libraries/Rbs/native/build/

# Temporary VS files
*.suo
*.csproj.user
*.wixproj.user
*.pidb

