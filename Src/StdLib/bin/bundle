#!/usr/bin/env ruby
# frozen_string_literal: true
#
# The bundle executable.  Bundler is a default gem on CRuby and RubyGems writes
# this binstub into RbConfig's bindir; IronRuby ships Bundler as part of its
# standard library, so this is that binstub without the $LOAD_PATH dance, which
# only matters when bundler lives in a gem directory.
#
# ir.sh puts this directory on RUBYPATH, which is where -S looks first, so
# `ir -S bundle` runs this rather than whatever binstub is on PATH.

# Exit cleanly from an early interrupt
Signal.trap("INT") do
  Bundler.ui.debug("\n#{caller.join("\n")}") if defined?(Bundler)
  exit 1
end

require "bundler"

require "bundler/friendly_errors"

Bundler.with_friendly_errors do
  require "bundler/cli"

  # Allow any command to use --help flag to show help for that command
  help_flags = %w[--help -h]
  help_flag_used = ARGV.any? {|a| help_flags.include? a }
  args = help_flag_used ? Bundler::CLI.reformatted_help_args(ARGV) : ARGV

  Bundler::CLI.start(args, debug: true)
end
