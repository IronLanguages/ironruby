#!/usr/bin/env ruby
# frozen_string_literal: true
#
# The gem executable.  RubyGems installs this into RbConfig's bindir on CRuby;
# IronRuby ships it as part of its standard library, and ir.sh puts this
# directory on RUBYPATH, so `ir -S gem` finds it before any binstub on PATH.
#
