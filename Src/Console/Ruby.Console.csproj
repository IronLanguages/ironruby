<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(IronRubyTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <AssemblyName>ir</AssemblyName>
    <RootNamespace>IronRuby.Hosting</RootNamespace>
  </PropertyGroup>
  <!-- Windows Forms and WPF are not part of .NET but of the Windows Desktop runtime,
       Microsoft.WindowsDesktop.App. On .NET Framework every machine had them in the GAC;
       on .NET 8 an app sees them only when its host references that framework, and
       System.Windows.Forms.rb, PresentationCore.rb and PresentationFramework.rb load them
       by name. So ir references it whenever the build targets Windows: a win-* RID, or no
       RID on a Windows machine. A self-contained build (the release archive) then carries
       it; a framework-dependent one needs it installed, which every Windows .NET SDK does.
       The TFM stays net8.0 - only UseWindowsForms/UseWPF insist on net8.0-windows - so the
       bin paths the launchers and scripts hardcode stay what they are.
       Build without it: -p:IronRubyWindowsDesktop=false. -->
  <PropertyGroup>
    <IronRubyWindowsDesktop Condition="'$(IronRubyWindowsDesktop)' == '' and $(RuntimeIdentifier.StartsWith('win'))">true</IronRubyWindowsDesktop>
    <IronRubyWindowsDesktop Condition="'$(IronRubyWindowsDesktop)' == '' and '$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">true</IronRubyWindowsDesktop>
    <!-- cross-publishing win-x64 from Linux or macOS: the SDK refuses a Windows-only framework there otherwise -->
    <EnableWindowsTargeting Condition="'$(IronRubyWindowsDesktop)' == 'true'">true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup Condition="'$(IronRubyWindowsDesktop)' == 'true'">
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- Ruby exposes UTF-7; must be set before any encoding is used (AppContext latches early in a console host) -->
    <RuntimeHostConfigurationOption Include="System.Text.Encoding.EnableUnsafeUTF7Encoding" Value="true" />
    <!-- On Unix, .NET emulates FileShare with flock(2). Ruby's open(2) takes no lock, and
         the emulation collides with a real File#flock: a second process cannot even open a
         file this process has LOCK_EX'd. Turn the emulation off. -->
    <RuntimeHostConfigurationOption Include="System.IO.DisableFileLocking" Value="true" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ruby\Ruby.csproj" />
    <ProjectReference Include="..\Libraries\IronRuby.Libraries.csproj" />
    <!-- yaml.rb load_assembly's this at runtime, so it has to sit next to the host -->
    <ProjectReference Include="..\Libraries.Yaml\IronRuby.Libraries.Yaml.csproj" />
    <ProjectReference Include="..\Prism\IronRuby.Prism.csproj" />
    <ProjectReference Include="$(DlrSourceDir)\Microsoft.Scripting\Microsoft.Scripting.csproj" />
    <ProjectReference Include="$(DlrSourceDir)\Microsoft.Dynamic\Microsoft.Dynamic.csproj" />
  </ItemGroup>
  <!-- IronRubyStartupProfile=true (Util/package-release.sh) has crossgen2 compile with Build/startup.mibc, a profile of
       the methods startup runs (Util/make-startup-mibc.sh). It pays off in a composite image of IronRuby and the
       framework (PublishReadyToRunComposite, self-contained only), where the generic instantiations startup makes
       over framework types become precompilable: `ir -e 1` then JITs ~140 methods instead of ~570 and runs 8% fewer
       instructions than in the self-contained per-assembly R2R build. In the framework-dependent host it changes next
       to nothing (1%), so the R2R host does not use it. -->
  <ItemGroup Condition="'$(IronRubyStartupProfile)' == 'true' and Exists('$(MSBuildThisFileDirectory)..\..\Build\startup.mibc')">
    <PublishReadyToRunPgoFiles Include="$(MSBuildThisFileDirectory)..\..\Build\startup.mibc" />
  </ItemGroup>
  <!-- A Release build on Linux also produces the ReadyToRun host (Util/publish-r2r.sh), which ir.sh runs by default:
       it starts about a third faster. The publish is a RuntimeIdentifier build of its own, so the target stays out of
       it, and IronRubyNestedR2R stops a publish from running it again. A failed publish only warns: the IL build is
       still good, and ir.sh does not pick a host older than the build. -->
  <Target Name="IronRubyReadyToRunHost" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' and '$(TargetFramework)' != '' and '$(RuntimeIdentifier)' == '' and '$(IronRubyNestedR2R)' != 'true' and '$(IronRubyR2R)' != 'false' and $([MSBuild]::IsOSPlatform('Linux'))">
    <Exec ContinueOnError="WarnAndContinue" Command="&quot;$(DOTNET_HOST_PATH)&quot; publish &quot;$(MSBuildProjectFullPath)&quot; -c Release -r linux-x64 --self-contained false -f $(TargetFramework) -p:PublishReadyToRun=true -p:IronRubyNestedR2R=true -p:IronRubyTargetFrameworks=$(TargetFramework) -p:DlrSourceDir=&quot;$(DlrSourceDir)&quot; -o &quot;$(MSBuildProjectDirectory)/bin/R2R/$(TargetFramework)&quot; -nologo" />
  </Target>
</Project>
